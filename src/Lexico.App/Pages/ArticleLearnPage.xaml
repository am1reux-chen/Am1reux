<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lexio.App.Pages.ArticleLearnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lexio.ViewModels">

    <Grid Padding="36,28,36,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="{x:Bind Vm.ArticleTitle, Mode=OneWay}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind Vm.TitleTranslation, Mode=OneWay}" Style="{StaticResource PageSubtitle}"
                           Visibility="{x:Bind Vm.ShowTitleTranslation, Mode=OneWay}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind Vm.ProgressText, Mode=OneWay}" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox ItemsSource="{x:Bind Vm.PracticeModes, Mode=OneWay}" DisplayMemberPath="Name"
                          SelectedValuePath="Mode" SelectedValue="{x:Bind Vm.Mode, Mode=OneWay}"
                          SelectionChanged="OnModeSelectionChanged" MinWidth="130"
                          IsEnabled="{x:Bind HiddenWhen(Vm.IsBusy), Mode=OneWay}"
                          AutomationProperties.Name="文章练习方式"/>
                <Button Content="返回文章列表" Command="{x:Bind Vm.EndCommand}"
                        Style="{StaticResource GhostButtonStyle}" Padding="14,8"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ReaderPane" RowSpacing="10" Visibility="{x:Bind Vm.ShowReader, Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="全文阅读 · 点击段落可跳转" Style="{StaticResource SectionHeader}"/>
                <ListView x:Name="ArticleReaderList" Grid.Row="1" ItemsSource="{x:Bind Vm.ReaderLines, Mode=OneWay}"
                          SelectedItem="{x:Bind Vm.CurrentReaderLine, Mode=OneWay}"
                          SelectionChanged="OnReaderSelectionChanged" SelectionMode="Single"
                          IsItemClickEnabled="False" Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArticleReaderLine">
                            <StackPanel Spacing="7" Padding="12,12,14,14">
                                <TextBlock Text="{x:Bind English}" FontSize="16" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind Chinese}" FontSize="14" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind HasChinese, Mode=OneTime}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{x:Bind Vm.ShowPractice, Mode=OneWay}">
                <StackPanel x:Name="PracticePanel" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            MaxWidth="760" Spacing="16" Padding="8,12">
                    <TextBlock Text="{x:Bind Vm.InputPrompt, Mode=OneWay}" FontSize="17" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind Vm.SentenceText, Mode=OneWay}" FontSize="24" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="720"
                               Visibility="{x:Bind Vm.ShowTypedSentence, Mode=OneWay}"/>
                    <TextBlock Text="听写模式 · 输入完整句子，标点也要一致" Style="{StaticResource HintTextStyle}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{x:Bind Vm.ShowDictationPrompt, Mode=OneWay}"/>
                    <Button Content="重播句子" Command="{x:Bind Vm.ReplayCommand}"
                            Visibility="{x:Bind Vm.ShowReplay, Mode=OneWay}" HorizontalAlignment="Center"
                            Style="{StaticResource GhostButtonStyle}" Padding="16,8"/>
                    <TextBox x:Name="SentenceInputBox" Text="{x:Bind Vm.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="输入完整英文句子" AcceptsReturn="True" TextWrapping="Wrap"
                             FontSize="18" MinHeight="90" MaxWidth="720" HorizontalAlignment="Stretch"
                             IsEnabled="{x:Bind HiddenWhen(Vm.IsBusy), Mode=OneWay}"
                             KeyDown="SentenceInputBox_KeyDown"/>
                    <Button Content="提交句子" Command="{x:Bind Vm.SubmitCommand}"
                            IsEnabled="{x:Bind Vm.CanSubmit, Mode=OneWay}"
                            HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="10" Padding="26,10"/>
                    <TextBlock Text="{x:Bind Vm.AnswerFeedback, Mode=OneWay}" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <Button Content="{x:Bind Vm.TranslationButtonText, Mode=OneWay}"
                                Visibility="{x:Bind Vm.ShowTranslationButton, Mode=OneWay}"
                                IsEnabled="{x:Bind HiddenWhen(Vm.IsBusy), Mode=OneWay}"
                                Click="OnTranslationClick" Style="{StaticResource GhostButtonStyle}" Padding="14,7"/>
                        <TextBlock Text="{x:Bind Vm.TranslationText, Mode=OneWay}" FontSize="18"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="720"
                                   Visibility="{x:Bind Vm.ShowTranslation, Mode=OneWay}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.ErrorText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <Grid ColumnSpacing="16" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Content="上一句" Command="{x:Bind Vm.PreviousCommand}"
                                IsEnabled="{x:Bind Vm.CanGoPrevious, Mode=OneWay}"
                                Style="{StaticResource GhostButtonStyle}" Padding="18,9"/>
                        <Button Grid.Column="1" Content="{x:Bind Vm.NextButtonText, Mode=OneWay}"
                                Command="{x:Bind Vm.NextCommand}" IsEnabled="{x:Bind Vm.CanGoNext, Mode=OneWay}"
                                Style="{StaticResource GhostButtonStyle}" Padding="18,9"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="CompletePanel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                        Visibility="{x:Bind Vm.ShowComplete, Mode=OneWay}">
                <FontIcon Glyph="&#xE73E;" FontSize="34" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="这篇文章已经学完" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="可切换练习方式后重新开始，也可以点击左侧段落从该处继续。" Style="{StaticResource HintTextStyle}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="{x:Bind Vm.ErrorText, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
                    <Button Content="重新开始" Command="{x:Bind Vm.RestartCommand}"
                            IsEnabled="{x:Bind HiddenWhen(Vm.IsBusy), Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" CornerRadius="10" Padding="22,10"/>
                    <Button Content="返回文章列表" Command="{x:Bind Vm.EndCommand}"
                            Style="{StaticResource GhostButtonStyle}" Padding="18,10"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="LoadErrorPanel" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                        Visibility="{x:Bind Vm.ShowLoadError, Mode=OneWay}">
                <TextBlock Text="{x:Bind Vm.ErrorText, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                <Button Content="返回文章列表" Click="OnReturnClick" HorizontalAlignment="Center"
                        Style="{StaticResource GhostButtonStyle}" Padding="18,9"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="左侧保留双语全文，当前段落会高亮；选择其他段落会保存位置并继续练习。"
                   Style="{StaticResource HintTextStyle}" TextAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
</Page>
