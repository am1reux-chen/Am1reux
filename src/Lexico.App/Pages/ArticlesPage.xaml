<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lexio.App.Pages.ArticlesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lexico.Core.Domain"
    xmlns:vm="using:Lexio.ViewModels"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="32,28,32,24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="Articles" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="双语全文阅读 · 逐句跟写或听写，进度会自动保存" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Content="新建" Command="{x:Bind Vm.NewArticleCommand}"
                        Style="{StaticResource GhostButtonStyle}" Padding="14,8"/>
                <Button Content="导入文章" Click="OnImportClick"
                        Style="{StaticResource AccentButtonStyle}" Padding="14,8" CornerRadius="8"
                        ToolTipService.ToolTip="导入 UTF-8 TXT、TypeWords JSON 或 TypeWords GitHub ZIP 文章书"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="ArticleListPane" Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="文章列表" Style="{StaticResource SectionHeader}"/>
                <Grid Grid.Row="1">
                    <ListView x:Name="ArticleList" ItemsSource="{x:Bind Vm.Articles, Mode=OneWay}"
                              SelectedItem="{x:Bind Vm.SelectedArticle, Mode=OneWay}"
                              SelectionChanged="OnArticleSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ArticleSummary">
                                <StackPanel Spacing="4" Padding="6,8">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind TitleTranslation}" Style="{StaticResource HintTextStyle}"
                                               TextWrapping="Wrap" Visibility="{x:Bind HasTitleTranslation, Mode=OneTime}"/>
                                    <TextBlock Text="{x:Bind ProgressText}" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <muxc:ProgressRing IsActive="{x:Bind Vm.Loading, Mode=OneWay}" Width="28" Height="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"/>
                </Grid>
            </Grid>

            <Grid x:Name="EditorPanel" Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Header="文章标题" Text="{x:Bind Vm.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="输入标题" FontSize="16"/>
                <TextBox Grid.Column="1" Header="标题译文" Text="{x:Bind Vm.TitleTranslation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="可选" FontSize="16"/>
                <ComboBox Grid.Column="2" Header="练习方式" ItemsSource="{x:Bind Vm.PracticeModes, Mode=OneWay}"
                              DisplayMemberPath="Name" SelectedValuePath="Mode"
                              SelectedValue="{x:Bind Vm.SelectedPracticeMode, Mode=TwoWay}"/>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Header="添加句子" Text="{x:Bind Vm.SentenceDraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="每行一句，可粘贴多行文本" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="84" MaxHeight="140" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <Button Grid.Column="1" Content="加入句子" Click="OnAddSentencesClick"
                            VerticalAlignment="Bottom" Style="{StaticResource GhostButtonStyle}" Padding="14,8"/>
                </Grid>

                <TextBlock Grid.Row="2" Text="句子与可选译文" Style="{StaticResource SectionHeader}"/>

                <ListView Grid.Row="3" ItemsSource="{x:Bind Vm.EditorSentences, Mode=OneWay}"
                          SelectionMode="None" Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArticleEditorSentence">
                            <Grid ColumnSpacing="8" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Header="英文句子" Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                                <TextBox Grid.Column="1" Header="译文（可选）"
                                         Text="{x:Bind Translation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                                <Button Grid.Column="2" Content="移除" Click="OnRemoveSentenceClick"
                                        VerticalAlignment="Center" Style="{StaticResource GhostButtonStyle}" Padding="8,6"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" Style="{StaticResource HintTextStyle}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="保存文章" Command="{x:Bind Vm.SaveArticleCommand}"
                            IsEnabled="{x:Bind HiddenWhen(Vm.Loading), Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" CornerRadius="8" Padding="16,8"/>
                    <Button Grid.Column="2" Content="练习" Command="{x:Bind Vm.PracticeCommand}"
                            CommandParameter="{x:Bind Vm.SelectedArticle, Mode=OneWay}"
                            IsEnabled="{x:Bind Vm.CanPractice, Mode=OneWay}"
                            Style="{StaticResource GhostButtonStyle}" Padding="14,8"/>
                    <Button Grid.Column="3" Content="删除" Click="OnDeleteArticleClick"
                            IsEnabled="{x:Bind Vm.HasSelectedArticle, Mode=OneWay}"
                            Style="{StaticResource GhostButtonStyle}" Padding="14,8"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
