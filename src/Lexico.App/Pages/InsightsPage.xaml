<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lexio.App.Pages.InsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lexio.ViewModels"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="36,28,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Insights" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="记忆状态 · 当日统计 · 未来负载" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="14" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                <StackPanel><TextBlock Text="{x:Bind Vm.NewCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/><TextBlock Text="新词" Style="{StaticResource MetricLabel}"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                <StackPanel><TextBlock Text="{x:Bind Vm.LearningCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/><TextBlock Text="学习中" Style="{StaticResource MetricLabel}"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                <StackPanel><TextBlock Text="{x:Bind Vm.ReviewCount, Mode=OneWay}" Style="{StaticResource MetricValue}"/><TextBlock Text="复习中" Style="{StaticResource MetricLabel}"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                <StackPanel><TextBlock Text="{x:Bind Vm.ReviewsToday, Mode=OneWay}" Style="{StaticResource MetricValue}"/><TextBlock Text="今日复习" Style="{StaticResource MetricLabel}"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                <StackPanel><TextBlock Text="{x:Bind Vm.RetentionText, Mode=OneWay}" Style="{StaticResource MetricValue}"/><TextBlock Text="30 天记住率" Style="{StaticResource MetricLabel}"/></StackPanel>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource MetricCardStyle}">
                <StackPanel><TextBlock Text="{x:Bind Vm.TotalReviewsText, Mode=OneWay}" Style="{StaticResource MetricValue}"/><TextBlock Text="累计复习" Style="{StaticResource MetricLabel}"/></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <muxc:ProgressRing IsActive="{x:Bind Vm.Loading, Mode=OneWay}" Width="32" Height="32"/>
            <StackPanel Spacing="10" VerticalAlignment="Top">
                <TextBlock Text="未来 7 天复习负载" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Vm.UpcomingText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ItemsControl ItemsSource="{x:Bind Vm.Bars, Mode=OneWay}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="18"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BarItem">
                            <StackPanel Spacing="4" Width="52" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind Count}" HorizontalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border Height="{x:Bind Height, Mode=OneWay}"
                                        Width="26" HorizontalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4,4,2,2}" VerticalAlignment="Bottom"/>
                                <TextBlock Text="{x:Bind Label}" HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
