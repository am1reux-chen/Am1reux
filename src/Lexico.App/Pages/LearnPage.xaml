<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lexio.App.Pages.LearnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Lexio.ViewModels">

    <Grid Padding="48,24,48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: progress + end -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Vm.ProgressText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" MinWidth="64"/>
                    <ProgressBar Grid.Column="1" Value="{x:Bind Vm.ProgressFraction, Mode=OneWay}" Maximum="1" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            <Button Grid.Column="1" Command="{x:Bind Vm.EndCommand}" Content="结束 (Esc)" Padding="14,6"/>
        </Grid>

        <!-- idle / not-in-session state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind Vm.ShowIdle, Mode=OneWay}">
            <TextBlock Text="当前没有进行中的学习" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="回到 Today 选择今日强度开始" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <!-- summary -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                    Visibility="{x:Bind Vm.Done, Mode=OneWay}">
            <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{ThemeResource SystemAccentColor}"/>
            <TextBlock Text="{x:Bind Vm.SummaryText, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind Vm.SummaryDetail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
            <Button Content="返回 Today" Margin="0,16,0,0" Click="OnBackToToday" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- waiting state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind Vm.Waiting, Mode=OneWay}">
            <muxc:ProgressRing IsActive="True" Width="36" Height="36"/>
            <TextBlock Text="{x:Bind Vm.WaitText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- card -->
        <Grid x:Name="CardPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="760"
              Visibility="{x:Bind Vm.ShowCard, Mode=OneWay}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <Border Visibility="{x:Bind Vm.ShowNewBadge, Mode=OneWay}"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="NEW" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="{x:Bind Vm.Lemma, Mode=OneWay}" FontSize="64" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display"/>
                    <Button Command="{x:Bind Vm.SpeakCommand}" ToolTipService.ToolTip="发音 (E)" Style="{StaticResource SubtleButtonStyle}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="E"/>
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE767;" FontSize="18"/>
                    </Button>
                </StackPanel>

                <TextBlock Text="{x:Bind Vm.Ipa, Mode=OneWay}" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Visibility="{x:Bind Vm.ShowIpa, Mode=OneWay}"/>

                <!-- question hint -->
                <Button Content="显示释义 (Space)" Command="{x:Bind Vm.RevealCommand}" Margin="0,28,0,0"
                        HorizontalAlignment="Center" Padding="22,10" FontSize="15"
                        Visibility="{x:Bind Vm.ShowQuestion, Mode=OneWay}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Space"/>
                    </Button.KeyboardAccelerators>
                </Button>

                <!-- answer -->
                <StackPanel Spacing="6" Margin="0,24,0,0" HorizontalAlignment="Stretch"
                            Visibility="{x:Bind Vm.Revealed, Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind Vm.Senses, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SenseLine">
                                <StackPanel Spacing="2" Margin="0,0,0,10">
                                    <TextBlock Text="{x:Bind Gloss}" FontSize="18" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind Example}" FontSize="14" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontStyle="Italic"
                                               Visibility="{x:Bind HasExample, Mode=OneWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <StackPanel Visibility="{x:Bind Vm.FourGradeMode, Mode=OneWay}" Orientation="Horizontal" Spacing="10">
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="1" Padding="20,10">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number1"/></Button.KeyboardAccelerators>
                                <StackPanel><TextBlock Text="忘记" FontWeight="SemiBold"/><TextBlock Text="Again" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                            </Button>
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="2" Padding="20,10">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number2"/></Button.KeyboardAccelerators>
                                <StackPanel><TextBlock Text="困难" FontWeight="SemiBold"/><TextBlock Text="Hard" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                            </Button>
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="3" Padding="20,10" Style="{StaticResource AccentButtonStyle}">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number3"/></Button.KeyboardAccelerators>
                                <StackPanel><TextBlock Text="良好" FontWeight="SemiBold"/><TextBlock Text="Good" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></StackPanel>
                            </Button>
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="4" Padding="20,10">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number4"/></Button.KeyboardAccelerators>
                                <StackPanel><TextBlock Text="简单" FontWeight="SemiBold"/><TextBlock Text="Easy" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Visibility="{x:Bind Vm.NotFourGradeMode, Mode=OneWay}" Orientation="Horizontal" Spacing="12">
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="1" Padding="24,12">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number1"/></Button.KeyboardAccelerators>
                                <StackPanel><TextBlock Text="忘记" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="刚才没想起来" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                            </Button>
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="3" Padding="24,12" Style="{StaticResource AccentButtonStyle}">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number3"/></Button.KeyboardAccelerators>
                                <StackPanel><TextBlock Text="记得" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="想起来了" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- footer hints -->
        <TextBlock Grid.Row="2" Text="Space 显示释义 · 1-4 评分 · E 发音 · Esc 结束"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"
                   HorizontalAlignment="Center"/>
    </Grid>
</Page>
