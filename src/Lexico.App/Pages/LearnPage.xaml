<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lexio.App.Pages.LearnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Lexio.ViewModels">

    <Grid Padding="52,28,52,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: slim progress + session end -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" ColumnSpacing="14" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Vm.ProgressText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" MinWidth="58"/>
                <ProgressBar Grid.Column="1" Value="{x:Bind Vm.ProgressFraction, Mode=OneWay}" Maximum="1"
                             Height="4" CornerRadius="2" VerticalAlignment="Center"/>
            </Grid>
            <Button Grid.Column="1" Command="{x:Bind Vm.EndCommand}" Content="结束"
                    Style="{StaticResource GhostButtonStyle}" Padding="14,7" FontSize="13"
                    ToolTipService.ToolTip="结束本次学习 (Esc)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape"/>
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!-- idle -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                    Visibility="{x:Bind Vm.ShowIdle, Mode=OneWay}">
            <FontIcon Glyph="&#xE8BD;" FontSize="34" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="现在没有进行中的学习" FontSize="19" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock Text="回到 Today 选择今日强度" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- summary -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                    Visibility="{x:Bind Vm.Done, Mode=OneWay}">
            <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="24" Width="56" Height="56"
                    HorizontalAlignment="Center" Margin="0,0,0,10">
                <FontIcon Glyph="&#xE73E;" FontSize="26" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="今日完成" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind Vm.SummaryText, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind Vm.SummaryDetail, Mode=OneWay}" FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <Button Content="返回 Today" Click="OnBackToToday" HorizontalAlignment="Center" Margin="0,22,0,0"
                    Style="{StaticResource GhostButtonStyle}" Padding="20,10"/>
        </StackPanel>

        <!-- waiting between short learning steps -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind Vm.Waiting, Mode=OneWay}">
            <muxc:ProgressRing IsActive="True" Width="30" Height="30"/>
            <TextBlock Text="{x:Bind Vm.WaitText, Mode=OneWay}" FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="保持窗口打开，到时会自动继续" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- the card -->
        <Grid x:Name="CardPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="720"
              Visibility="{x:Bind Vm.ShowCard, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <Border Visibility="{x:Bind Vm.ShowNewBadge, Mode=OneWay}"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3"
                            VerticalAlignment="Center" Margin="0,0,-4,0">
                        <TextBlock Text="NEW" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="{x:Bind Vm.Lemma, Mode=OneWay}" FontSize="60" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="560" VerticalAlignment="Center"/>
                    <Button Command="{x:Bind Vm.SpeakCommand}" ToolTipService.ToolTip="发音 (E)"
                            Style="{StaticResource RoundIconButtonStyle}" VerticalAlignment="Center">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="E"/>
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE767;" FontSize="16"/>
                    </Button>
                </StackPanel>

                <TextBlock Text="{x:Bind Vm.Ipa, Mode=OneWay}" FontSize="17"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           Visibility="{x:Bind Vm.ShowIpa, Mode=OneWay}"/>

                <!-- question -->
                <StackPanel HorizontalAlignment="Center" Margin="0,44,0,0" Spacing="8"
                            Visibility="{x:Bind Vm.ShowQuestion, Mode=OneWay}">
                    <Button Command="{x:Bind Vm.RevealCommand}" Content="显示释义"
                            Style="{StaticResource GhostButtonStyle}" Padding="26,12" FontSize="15">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Space"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <TextBlock Text="Space" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- answer -->
                <StackPanel x:Name="AnswerPanel" Spacing="0" Margin="0,32,0,0" HorizontalAlignment="Stretch"
                            Visibility="{x:Bind Vm.Revealed, Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind Vm.Senses, Mode=OneWay}" HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SenseLine">
                                <StackPanel Spacing="3" Margin="0,0,0,14" HorizontalAlignment="Left">
                                    <TextBlock Text="{x:Bind Gloss}" FontSize="19" TextWrapping="Wrap" MaxWidth="600"/>
                                    <TextBlock Text="{x:Bind Example}" FontSize="13.5" TextWrapping="Wrap" MaxWidth="600"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontStyle="Italic"
                                               Visibility="{x:Bind HasExample, Mode=OneWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <!-- 4-grade -->
                        <StackPanel Visibility="{x:Bind Vm.FourGradeMode, Mode=OneWay}" Orientation="Horizontal" Spacing="12">
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="1" Style="{StaticResource GradeButtonStyle}">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number1"/></Button.KeyboardAccelerators>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="忘记" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Again · 1" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="2" Style="{StaticResource GradeButtonStyle}">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number2"/></Button.KeyboardAccelerators>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="困难" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Hard · 2" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="3" Style="{StaticResource AccentButtonStyle}"
                                    CornerRadius="8" MinHeight="48" MinWidth="112">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number3"/></Button.KeyboardAccelerators>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="良好" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Good · 3" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="4" Style="{StaticResource GradeButtonStyle}">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number4"/></Button.KeyboardAccelerators>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="简单" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Easy · 4" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- 2-grade -->
                        <StackPanel Visibility="{x:Bind Vm.NotFourGradeMode, Mode=OneWay}" Orientation="Horizontal" Spacing="14">
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="1" Style="{StaticResource GradeButtonStyle}" MinWidth="148">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number1"/></Button.KeyboardAccelerators>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="忘记" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/>
                                    <TextBlock Text="刚才没想起来 · 1" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind Vm.GradeCommand}" CommandParameter="3" Style="{StaticResource AccentButtonStyle}"
                                    CornerRadius="8" MinHeight="48" MinWidth="148">
                                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Number3"/></Button.KeyboardAccelerators>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="记得" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/>
                                    <TextBlock Text="想起来了 · 3" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- keyboard hints -->
        <TextBlock Grid.Row="2" Text="Space 显示释义 · 1–4 评分 · E 发音 · Esc 结束"
                   Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center"
                   Visibility="{x:Bind Vm.ShowCard, Mode=OneWay}"/>
    </Grid>
</Page>
