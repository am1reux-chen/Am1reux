<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lexio.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Lexico.Core.Domain"
    xmlns:vm="using:Lexio.ViewModels"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="40,32,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
            <TextBlock Text="Library" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="搜索词库 · 管理词书 · 导入自定义内容" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <Button Grid.Row="0" Grid.Column="1" Click="OnImportClick" VerticalAlignment="Bottom"
                Style="{StaticResource GhostButtonStyle}" Padding="14,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                <TextBlock Text="导入 CSV / TXT" FontSize="13"/>
            </StackPanel>
        </Button>

        <!-- search -->
        <Grid x:Name="SearchRoot" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,4">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="搜索单词，输入即出结果"
                     TextChanged="OnSearchTextChanged"
                     Height="42" FontSize="15" CornerRadius="10"
                     Padding="44,0,14,0" VerticalContentAlignment="Center"/>
            <FontIcon Glyph="&#xE721;" FontSize="15" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <!-- status line -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="10" Margin="2,6,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Vm.ResultCountText, Mode=OneWay}" Style="{StaticResource HintTextStyle}" VerticalAlignment="Center"/>
            <muxc:ProgressRing Grid.Column="1" IsActive="{x:Bind Vm.Searching, Mode=OneWay}" Width="18" Height="18"/>
        </Grid>

        <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- results -->
            <Grid Grid.Column="0">
                <!-- initial state -->
                <StackPanel x:Name="InitialHintPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="输入关键词搜索词库" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- no results -->
                <StackPanel x:Name="EmptyResultsPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7BA;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="没有找到匹配的单词" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="换个拼写或更短的关键词试试" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center"/>
                </StackPanel>
                <ListView x:Name="ResultsList" ItemsSource="{x:Bind Vm.Results, Mode=OneWay}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnWordClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,4"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResultItem">
                            <Grid Padding="8,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Word.Lemma}" FontSize="16.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind Word.IpaUs}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                               Text="{x:Bind FirstLine}" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <FontIcon Grid.Column="1" Glyph="&#xE767;" FontSize="13"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- decks -->
            <StackPanel Grid.Column="1" Spacing="10" MinWidth="240">
                <TextBlock Text="词书" Style="{StaticResource SectionHeader}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <StackPanel x:Name="DecksEmptyHint" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="还没有词书" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="内置词库会在首次启动时就绪；也可以从右上角导入 CSV / TXT" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind Vm.Decks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DeckInfo">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            Padding="14,12" Margin="0,0,0,2">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind Description}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind WordCount}" FontSize="19" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
