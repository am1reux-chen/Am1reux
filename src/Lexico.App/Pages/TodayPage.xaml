<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lexio.App.Pages.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lexio.ViewModels"
    xmlns:local="using:Lexio.App.Pages"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Page.Resources>
        <!-- Plan cards put the new-word target first and keep reviews and time visible. -->
        <DataTemplate x:Key="TierTemplate" x:DataType="vm:IntensityOption">
            <Button Command="{Binding Start}" CommandParameter="{Binding}"
                    HorizontalAlignment="Stretch" Padding="20,18"
                    Style="{StaticResource CardButtonStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind NewText}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind MinutesText}" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ReviewsText}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind Description}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Recommended plan: accent outline + 推荐 chip -->
        <DataTemplate x:Key="NormalTierTemplate" x:DataType="vm:IntensityOption">
            <Button Command="{Binding Start}" CommandParameter="{Binding}"
                    HorizontalAlignment="Stretch" Padding="20,18"
                    Background="{ThemeResource LexioAccentSurfaceBrush}"
                    BorderBrush="{ThemeResource LexioAccentStrokeBrush}"
                    Style="{StaticResource CardButtonStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind NewText}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind MinutesText}" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold"/>
                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="7,2">
                                <TextBlock Text="推荐" FontSize="12" Foreground="{ThemeResource LexioAccentBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ReviewsText}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind Description}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <local:TierTemplateSelector x:Key="TierSelector"
                                    Normal="{StaticResource NormalTierTemplate}"
                                    Other="{StaticResource TierTemplate}"/>
    </Page.Resources>

    <Grid Padding="40,32,40,28" RowSpacing="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{x:Bind Vm.Greeting, Mode=OneWay}" Style="{StaticResource PageTitle}"/>
            <StackPanel Spacing="5" Margin="0,0,0,4">
                <TextBlock Text="{x:Bind Vm.DateText, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind Vm.DueText, Mode=OneWay}" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Grid ColumnSpacing="8" Visibility="{x:Bind LoadErrorVisibility(Vm.LoadError), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Vm.LoadError, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <Button Grid.Column="1" Content="重试" Command="{x:Bind Vm.RetryCommand}"
                            Style="{StaticResource GhostButtonStyle}" Padding="12,6"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="880"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <muxc:ProgressRing IsActive="{x:Bind Vm.Loading, Mode=OneWay}" Width="34" Height="34"/>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                <TextBlock Text="选择学习词书" Style="{StaticResource SectionHeader}" Margin="2,0,0,2"/>
                <ComboBox ItemsSource="{x:Bind Vm.DeckChoices, Mode=OneWay}"
                          SelectedItem="{x:Bind Vm.SelectedDeckChoice, Mode=OneWay}"
                          SelectionChanged="StudyDeckPicker_SelectionChanged"
                          IsEnabled="{x:Bind Vm.CanSelectDeck, Mode=OneWay}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:StudyDeckChoice">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name}"/>
                                <TextBlock Text="{x:Bind DetailText}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="练习方式" Style="{StaticResource SectionHeader}" Margin="2,8,0,2"/>
                <ComboBox ItemsSource="{x:Bind Vm.StudyModes, Mode=OneWay}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Mode"
                          SelectedValue="{x:Bind Vm.SelectedStudyMode, Mode=TwoWay}"
                          IsEnabled="{x:Bind Vm.CanSelectStudyMode, Mode=OneWay}"
                          HorizontalAlignment="Stretch"/>
                <TextBlock Text="看义拼写和自测会检查所选计划是否有足够释义。"
                           Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="2,0,0,2"/>
                <TextBlock Text="今天学多少" Style="{StaticResource SectionHeader}" Margin="2,0,0,2"/>
                <ItemsControl ItemsSource="{x:Bind Vm.Options, Mode=OneWay}" ItemTemplateSelector="{StaticResource TierSelector}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="今天没有待学词卡。添加新词，或等到复习卡到期后再来。" Style="{StaticResource HintTextStyle}"
                           TextWrapping="Wrap" Margin="2,0,0,0"
                           Visibility="{x:Bind NoTasksVisibility(Vm.NoTasks), Mode=OneWay}"/>
                <TextBlock Text="新词量会按复习负担和你的学习速度调整，待复习卡优先。" Style="{StaticResource HintTextStyle}" Margin="2,4,0,8"/>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
