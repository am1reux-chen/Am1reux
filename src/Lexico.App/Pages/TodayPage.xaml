<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lexio.App.Pages.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lexio.ViewModels"
    xmlns:local="using:Lexio.App.Pages"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Page.Resources>
        <!-- Standard tier card -->
        <DataTemplate x:Key="TierTemplate" x:DataType="vm:IntensityOption">
            <Button Command="{Binding Start}" CommandParameter="{Binding}"
                    HorizontalAlignment="Stretch" Padding="22,16"
                    Style="{StaticResource CardButtonStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind TagText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind Description}" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>

                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ReviewsText}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind NewText}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind MinutesText}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Recommended (Normal) tier: accent outline + 推荐 chip -->
        <DataTemplate x:Key="NormalTierTemplate" x:DataType="vm:IntensityOption">
            <Button Command="{Binding Start}" CommandParameter="{Binding}"
                    HorizontalAlignment="Stretch" Padding="22,16"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Style="{StaticResource CardButtonStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind TagText}" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                        <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="推荐" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind Description}" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>

                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ReviewsText}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind NewText}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind MinutesText}" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <local:TierTemplateSelector x:Key="TierSelector"
                                    Normal="{StaticResource NormalTierTemplate}"
                                    Other="{StaticResource TierTemplate}"/>
    </Page.Resources>

    <Grid Padding="40,32,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{x:Bind Vm.Greeting, Mode=OneWay}" Style="{StaticResource PageTitle}"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <TextBlock Text="{x:Bind Vm.DateText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="·" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Bind Vm.DueText, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" VerticalAlignment="Center">
            <muxc:ProgressRing IsActive="{x:Bind Vm.Loading, Mode=OneWay}" Width="34" Height="34"/>
            <StackPanel MaxWidth="620" HorizontalAlignment="Stretch" Spacing="12">
                <TextBlock Text="今日强度" Style="{StaticResource HintTextStyle}" Margin="2,0,0,2"/>
                <ItemsControl ItemsSource="{x:Bind Vm.Options, Mode=OneWay}" ItemTemplateSelector="{StaticResource TierSelector}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="点击任意强度立即开始" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
