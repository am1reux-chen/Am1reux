<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lexio.App.Pages.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lexio.ViewModels"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="36,28,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="{x:Bind Vm.Greeting, Mode=OneWay}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{x:Bind Vm.DateText, Mode=OneWay}" Style="{StaticResource PageSubtitle}"/>
            <TextBlock Text="{x:Bind Vm.DueText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14"/>
        </StackPanel>

        <Grid Grid.Row="1" VerticalAlignment="Center">
            <muxc:ProgressRing IsActive="{x:Bind Vm.Loading, Mode=OneWay}" Width="40" Height="40"/>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind Vm.Options, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IntensityOption">
                            <Button Command="{Binding Start}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    Padding="20,14"
                                    CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="{x:Bind Title}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
