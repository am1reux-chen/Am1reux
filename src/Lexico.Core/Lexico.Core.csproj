<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Lexio core: domain, scheduling (FSRS-6), planning, SQLite data layer, dictionary services.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSRS.Core" Version="1.0.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lexico.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Dictionary\starter-dictionary.json" Condition="'$(ExcludeStarterDictionaryFromPublish)' != 'true'" />
    <EmbeddedResource Include="Dictionary\builtin-vocabulary.json" />
  </ItemGroup>
</Project>
